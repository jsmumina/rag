# ---- Model provider: ONE of these is enough ----
# Free, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OR:
OPENAI_API_KEY=
# Optional: force a provider when both keys are present (google | openai)
LLM_PROVIDER=

# ---- Optional: enables the web-search fallback node ----
# Without it the agent simply skips the web fallback (no crash).
TAVILY_API_KEY=

# ---- Vector store ----
# Leave blank -> embedded Qdrant on local disk (fine locally).
# On Hugging Face Spaces the disk is wiped on restart, so point this at a
# free Qdrant Cloud cluster to keep your ingested documents.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_db

# ---- Optional overrides (defaults are picked per provider) ----
# Gemini: gemini-2.0-flash / models/text-embedding-004 / dim 768
# OpenAI: gpt-4o-mini      / text-embedding-3-small    / dim 1536
CHAT_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
QDRANT_COLLECTION=
MAX_RETRIES=3

# ---- Free-tier rate limiting during ingest ----
EMBED_BATCH_SIZE=50
EMBED_BATCH_PAUSE=20
